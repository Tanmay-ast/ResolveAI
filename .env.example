# ResolveAI Environment Configuration Template
# Copy this file to .env before starting the application:
# cp .env.example .env

# Server Configuration
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# Client Configuration
VITE_API_URL=http://localhost:3001

# AI Reasoning Provider Configuration
# Options: 'local' (₹0 default, deterministic heuristic agent, no API keys or local LLM required)
#          'gemini' (Optional free-tier Google Gemini API adapter)
AI_PROVIDER=local

# Optional Gemini API Key (ONLY needed if AI_PROVIDER is explicitly set to 'gemini')
# Get a free key at: https://aistudio.google.com/
# Leave empty to run 100% offline with zero external dependencies
GEMINI_API_KEY=

# Agent Step Simulation Latency in milliseconds (allows smooth step-by-step UI observation)
AGENT_STEP_DELAY_MS=500
